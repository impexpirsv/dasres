generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expert {
  id                 Int                @id @default(autoincrement())
  name               String
  country            String
  specialty          String
  status             String
  experience         String
  email              String
  imageUrl           String?
  createdAt          DateTime           @default(now())
  planType           PlanType           @default(FREE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ownerId            Int?
  proposals          CaseProposal[]
  owner              User?              @relation(fields: [ownerId], references: [id])
  savedBy            SavedExpert[]
}

model Company {
  id                 Int                @id @default(autoincrement())
  name               String
  country            String
  category           String
  status             String
  description        String
  email              String
  website            String
  logoUrl            String?
  createdAt          DateTime           @default(now())
  planType           PlanType           @default(FREE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ownerId            Int?
  proposals          CaseProposal[]
  owner              User?              @relation(fields: [ownerId], references: [id])
  savedBy            SavedCompany[]
}

model Opportunity {
  id          Int     @id @default(autoincrement())
  title       String
  country     String
  status      String
  description String
  imageUrl    String?
}

model User {
  id                     Int                     @id @default(autoincrement())
  name                   String
  email                  String                  @unique
  password               String
  role                   String                  @default("user")
  createdAt              DateTime                @default(now())
  planType               PlanType                @default(FREE)
  caseActivities         CaseActivity[]
  caseDocuments          CaseDocument[]
  caseMessages           CaseMessage[]
  companies              Company[]
  experts                Expert[]
  notifications          Notification[]
  assignedProjectTasks   ProjectTask[]           @relation("ProjectTaskAssignee")
  projectTaskAttachments ProjectTaskAttachment[]
  projectTaskComments    ProjectTaskComment[]
  reviewsReceived        Review[]                @relation("ReviewTarget")
  reviewsGiven           Review[]                @relation("ReviewAuthor")
  savedCases             SavedCase[]
  savedCompanies         SavedCompany[]
  savedExperts           SavedExpert[]
  sessions               Session[]
  tickets                Ticket[]
  ticketMessages         TicketMessage[]
  customerCases          TradeCase[]             @relation("CustomerCases")
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradeCase {
  id                 Int            @id @default(autoincrement())
  title              String
  description        String
  status             CaseStatus     @default(OPEN)
  customerId         Int
  assignedToId       Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  acceptedProposalId Int?
  assignedAt         DateTime?
  category           String         @default("General")
  activities         CaseActivity[]
  documents          CaseDocument[]
  messages           CaseMessage[]
  proposals          CaseProposal[]
  steps              CaseStep[]
  project            Project?
  reviews            Review[]
  savedCases         SavedCase[]
  customer           User           @relation("CustomerCases", fields: [customerId], references: [id], onDelete: Cascade)
}

model Project {
  id          Int           @id @default(autoincrement())
  tradeCaseId Int           @unique
  title       String
  description String?
  createdBy   Int?
  assignedTo  Int?
  status      ProjectStatus @default(ACTIVE)
  progress    Int           @default(0)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tradeCase   TradeCase     @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)
  tasks       ProjectTask[]
}

model ProjectTask {
  id             Int                     @id @default(autoincrement())
  projectId      Int
  title          String
  description    String?
  status         TaskStatus              @default(TODO)
  priority       TaskPriority            @default(MEDIUM)
  assignedToId   Int?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  actualHours    Int?
  estimatedHours Int?
  sortOrder      Int                     @default(0)
  startDate      DateTime?
  progress       Int                     @default(0)
  dependsOnId    Int?
  loggedHours    Int                     @default(0)
  remainingHours Int                     @default(0)
  assignedTo     User?                   @relation("ProjectTaskAssignee", fields: [assignedToId], references: [id])
  dependsOn      ProjectTask?            @relation("TaskDependencies", fields: [dependsOnId], references: [id])
  dependents     ProjectTask[]           @relation("TaskDependencies")
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments    ProjectTaskAttachment[]
  checklistItems ProjectTaskChecklist[]
  comments       ProjectTaskComment[]
}

model ProjectTaskChecklist {
  id          Int         @id @default(autoincrement())
  taskId      Int
  title       String
  completed   Boolean     @default(false)
  completedAt DateTime?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ProjectTaskAttachment {
  id              Int         @id @default(autoincrement())
  taskId          Int
  fileName        String
  fileUrl         String
  storageProvider String      @default("local")
  mimeType        String?
  fileSize        Int?
  uploadedById    Int?
  createdAt       DateTime    @default(now())
  task            ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy      User?       @relation(fields: [uploadedById], references: [id])
}

model ProjectTaskComment {
  id        Int                  @id @default(autoincrement())
  taskId    Int
  authorId  Int?
  content   String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  parentId  Int?
  editedAt  DateTime?
  isDeleted Boolean              @default(false)
  author    User?                @relation(fields: [authorId], references: [id])
  parent    ProjectTaskComment?  @relation("TaskCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ProjectTaskComment[] @relation("TaskCommentReplies")
  task      ProjectTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model CaseProposal {
  id        Int            @id @default(autoincrement())
  caseId    Int
  companyId Int?
  expertId  Int?
  message   String
  price     String?
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  tradeCase TradeCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company   Company?       @relation(fields: [companyId], references: [id])
  expert    Expert?        @relation(fields: [expertId], references: [id])
}

model CaseStep {
  id          Int       @id @default(autoincrement())
  caseId      Int
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  tradeCase   TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id         Int       @id @default(autoincrement())
  caseId     Int
  name       String
  fileUrl    String
  createdAt  DateTime  @default(now())
  uploaderId Int
  tradeCase  TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploaderId], references: [id])
}

model CaseMessage {
  id        Int       @id @default(autoincrement())
  caseId    Int
  content   String
  createdAt DateTime  @default(now())
  senderId  Int
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id             Int        @id @default(autoincrement())
  caseId         Int?
  reviewerId     Int
  reviewedUserId Int
  rating         Int
  comment        String?
  createdAt      DateTime   @default(now())
  tradeCase      TradeCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewedUser   User       @relation("ReviewTarget", fields: [reviewedUserId], references: [id])
  reviewer       User       @relation("ReviewAuthor", fields: [reviewerId], references: [id])
}

model Ticket {
  id        Int             @id @default(autoincrement())
  userId    Int
  subject   String
  status    String          @default("OPEN")
  category  String          @default("GENERAL")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  senderId  Int
  message   String
  createdAt DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model CaseActivity {
  id        Int       @id @default(autoincrement())
  caseId    Int
  userId    Int?
  action    String
  details   String?
  createdAt DateTime  @default(now())
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
}

model SavedCase {
  id        Int       @id @default(autoincrement())
  userId    Int
  caseId    Int
  createdAt DateTime  @default(now())
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
}

model SavedCompany {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model SavedExpert {
  id        Int      @id @default(autoincrement())
  userId    Int
  expertId  Int
  createdAt DateTime @default(now())
  expert    Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expertId])
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PlanType {
  FREE
  GOLD
  DIAMOND
  ENTERPRISE
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
