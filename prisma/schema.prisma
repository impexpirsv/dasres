generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expert {
  id                 Int                @id @default(autoincrement())
  name               String
  country            String
  specialty          String
  status             String
  experience         String
  email              String
  imageUrl           String?
  createdAt          DateTime           @default(now())
  planType           PlanType           @default(FREE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ownerId            Int?
  proposals          CaseProposal[]
  owner              User?              @relation(fields: [ownerId], references: [id])
}

model Company {
  id                 Int                @id @default(autoincrement())
  name               String
  country            String
  category           String
  status             String
  description        String
  email              String
  website            String
  logoUrl            String?
  createdAt          DateTime           @default(now())
  planType           PlanType           @default(FREE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ownerId            Int?
  proposals          CaseProposal[]
  owner              User?              @relation(fields: [ownerId], references: [id])
}

model Opportunity {
  id          Int     @id @default(autoincrement())
  title       String
  country     String
  status      String
  description String
  imageUrl    String?
}

model User {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  password        String
  role            String          @default("user")
  createdAt       DateTime        @default(now())
  companies       Company[]
  experts         Expert[]
  notifications   Notification[]
  sessions        Session[]
  caseMessages    CaseMessage[]
  caseDocuments   CaseDocument[]
  tickets         Ticket[]
  ticketMessages  TicketMessage[]
  reviewsGiven    Review[]        @relation("ReviewAuthor")
  caseActivities  CaseActivity[]
  reviewsReceived Review[]        @relation("ReviewTarget")
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradeCase {
  id                 Int            @id @default(autoincrement())
  title              String
  description        String
  status             CaseStatus     @default(OPEN)
  customerId         Int
  assignedToId       Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  acceptedProposalId Int?
  assignedAt         DateTime?
  category           String         @default("General")
  documents          CaseDocument[]
  messages           CaseMessage[]
  proposals          CaseProposal[]
  steps              CaseStep[]
  reviews            Review[]
  activities         CaseActivity[]
}

model CaseProposal {
  id        Int            @id @default(autoincrement())
  caseId    Int
  companyId Int?
  expertId  Int?
  message   String
  price     String?
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  tradeCase TradeCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company   Company?       @relation(fields: [companyId], references: [id])
  expert    Expert?        @relation(fields: [expertId], references: [id])
}

model CaseStep {
  id          Int       @id @default(autoincrement())
  caseId      Int
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  tradeCase   TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id Int @id @default(autoincrement())

  caseId     Int
  uploaderId Int

  name    String
  fileUrl String

  createdAt DateTime @default(now())

  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  uploader User @relation(fields: [uploaderId], references: [id])
}

model CaseMessage {
  id Int @id @default(autoincrement())

  caseId   Int
  senderId Int

  content String

  createdAt DateTime @default(now())

  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id Int @id @default(autoincrement())

  caseId Int?

  reviewerId     Int
  reviewedUserId Int

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  tradeCase TradeCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  reviewer     User @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewedUser User @relation("ReviewTarget", fields: [reviewedUserId], references: [id])
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Ticket {
  id Int @id @default(autoincrement())

  userId Int

  subject  String
  status   String @default("OPEN")
  category String @default("GENERAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages TicketMessage[]
}

model TicketMessage {
  id Int @id @default(autoincrement())

  ticketId Int
  senderId Int

  message String

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model CaseActivity {
  id Int @id @default(autoincrement())

  caseId Int
  userId Int?

  action  String
  details String?

  createdAt DateTime @default(now())

  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum PlanType {
  FREE
  GOLD
  DIAMOND
  ENTERPRISE
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}
