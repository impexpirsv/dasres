generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expert {
  id                 Int                @id @default(autoincrement())
  name               String
  country            String
  specialty          String
  status             String
  experience         String
  email              String
  imageUrl           String?
  createdAt          DateTime           @default(now())
  planType           PlanType           @default(FREE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ownerId            Int?
  proposals          CaseProposal[]
  owner              User?              @relation(fields: [ownerId], references: [id])
  savedBy            SavedExpert[]

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([planType])
  @@index([country])
  @@index([specialty])
  @@index([createdAt])
  @@index([verificationStatus, country])
  @@index([verificationStatus, specialty])
  @@index([ownerId, verificationStatus])
}

model Company {
  id                 Int                @id @default(autoincrement())
  name               String
  country            String
  category           String
  status             String
  description        String
  email              String
  website            String
  logoUrl            String?
  createdAt          DateTime           @default(now())
  planType           PlanType           @default(FREE)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  ownerId            Int?
  proposals          CaseProposal[]
  owner              User?              @relation(fields: [ownerId], references: [id])
  savedBy            SavedCompany[]

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([planType])
  @@index([category])
  @@index([country])
  @@index([createdAt])
  @@index([verificationStatus, country])
  @@index([verificationStatus, category])
  @@index([ownerId, verificationStatus])
}

model Opportunity {
  id          Int     @id @default(autoincrement())
  title       String
  country     String
  status      String
  description String
  imageUrl    String?

  @@index([country])
  @@index([status])
  @@index([status, country])
}

model User {
  id                     Int                     @id @default(autoincrement())
  name                   String
  email                  String                  @unique
  password               String
  role                   String                  @default("user")
  createdAt              DateTime                @default(now())
  emailVerifiedAt        DateTime?
  planType               PlanType                @default(FREE)
  caseActivities         CaseActivity[]
  caseDocuments          CaseDocument[]
  caseMessages           CaseMessage[]
  companies              Company[]
  experts                Expert[]
  identityTokens         IdentityToken[]
  notifications          Notification[]
  projectMessages        ProjectMessage[]
  assignedProjectTasks   ProjectTask[]           @relation("ProjectTaskAssignee")
  approvedAttachments    ProjectTaskAttachment[] @relation("AttachmentApprover")
  projectTaskAttachments ProjectTaskAttachment[]
  projectTaskComments    ProjectTaskComment[]
  reviewsReceived        Review[]                @relation("ReviewTarget")
  reviewsGiven           Review[]                @relation("ReviewAuthor")
  savedCases             SavedCase[]
  savedCompanies         SavedCompany[]
  savedExperts           SavedExpert[]
  sessions               Session[]
  subscription           Subscription?
  tickets                Ticket[]
  ticketMessages         TicketMessage[]
  customerCases          TradeCase[]             @relation("CustomerCases")

  @@index([role])
  @@index([planType])
  @@index([createdAt])
  @@index([role, planType])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model IdentityToken {
  id          Int                  @id @default(autoincrement())
  userId      Int
  purpose     IdentityTokenPurpose
  tokenHash   String               @unique
  targetEmail String?
  createdAt   DateTime             @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@index([userId, purpose])
}

model Subscription {
  id               Int                @id @default(autoincrement())
  userId           Int                @unique
  plan             PlanType
  status           SubscriptionStatus @default(ACTIVE)
  startsAt         DateTime           @default(now())
  expiresAt        DateTime?
  paymentProvider  String?
  paymentReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@index([expiresAt])
  @@index([status, expiresAt])
}

model TradeCase {
  id                 Int            @id @default(autoincrement())
  title              String
  description        String
  status             CaseStatus     @default(OPEN)
  customerId         Int
  assignedToId       Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  acceptedProposalId Int?
  assignedAt         DateTime?
  category           String         @default("General")
  activities         CaseActivity[]
  documents          CaseDocument[]
  messages           CaseMessage[]
  proposals          CaseProposal[]
  steps              CaseStep[]
  project            Project?
  reviews            Review[]
  savedCases         SavedCase[]
  customer           User           @relation("CustomerCases", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([assignedToId])
  @@index([acceptedProposalId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([customerId, status])
  @@index([status, category])
  @@index([status, createdAt])
}

model Project {
  id            Int                   @id @default(autoincrement())
  tradeCaseId   Int                   @unique
  title         String
  description   String?
  createdBy     Int?
  assignedTo    Int?
  status        ProjectStatus         @default(ACTIVE)
  progress      Int                   @default(0)
  startedAt     DateTime              @default(now())
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tradeCase     TradeCase             @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)
  conversations ProjectConversation[]
  tasks         ProjectTask[]

  @@index([status])
  @@index([createdBy])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([updatedAt])
}

model ProjectTask {
  id             Int                     @id @default(autoincrement())
  projectId      Int
  title          String
  description    String?
  status         TaskStatus              @default(TODO)
  priority       TaskPriority            @default(MEDIUM)
  assignedToId   Int?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  actualHours    Int?
  estimatedHours Int?
  sortOrder      Int                     @default(0)
  startDate      DateTime?
  progress       Int                     @default(0)
  dependsOnId    Int?
  loggedHours    Int                     @default(0)
  remainingHours Int                     @default(0)
  assignedTo     User?                   @relation("ProjectTaskAssignee", fields: [assignedToId], references: [id])
  dependsOn      ProjectTask?            @relation("TaskDependencies", fields: [dependsOnId], references: [id])
  dependents     ProjectTask[]           @relation("TaskDependencies")
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments    ProjectTaskAttachment[]
  checklistItems ProjectTaskChecklist[]
  comments       ProjectTaskComment[]

  @@index([projectId, status, sortOrder])
  @@index([projectId])
  @@index([assignedToId])
  @@index([dependsOnId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([projectId, status])
  @@index([projectId, sortOrder])
  @@index([assignedToId, status])
  @@index([assignedToId, dueDate])
  @@index([status, dueDate])
}

model ProjectTaskChecklist {
  id          Int         @id @default(autoincrement())
  taskId      Int
  title       String
  completed   Boolean     @default(false)
  completedAt DateTime?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, sortOrder])
  @@index([taskId, completed])
}

model ProjectTaskAttachment {
  id              Int            @id @default(autoincrement())
  taskId          Int
  fileName        String
  storageKey      String         @unique
  storageProvider String         @default("local")
  mimeType        String?
  fileSize        Int?
  uploadedById    Int?
  createdAt       DateTime       @default(now())
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedById    Int?
  rejectionReason String?
  approvedBy      User?          @relation("AttachmentApprover", fields: [approvedById], references: [id])
  task            ProjectTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([uploadedById])
  @@index([approvedById])
  @@index([approvalStatus])
  @@index([createdAt])
  @@index([taskId, createdAt])
  @@index([taskId, approvalStatus])
}

model ProjectTaskComment {
  id        Int                  @id @default(autoincrement())
  taskId    Int
  authorId  Int?
  content   String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  parentId  Int?
  editedAt  DateTime?
  isDeleted Boolean              @default(false)
  author    User?                @relation(fields: [authorId], references: [id])
  parent    ProjectTaskComment?  @relation("TaskCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ProjectTaskComment[] @relation("TaskCommentReplies")
  task      ProjectTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
  @@index([taskId, createdAt])
  @@index([taskId, isDeleted])
}

model CaseProposal {
  id        Int            @id @default(autoincrement())
  caseId    Int
  companyId Int
  expertId  Int?
  message   String
  price     String?
  status    ProposalStatus @default(PENDING)
  createdAt DateTime       @default(now())
  tradeCase TradeCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  company   Company        @relation(fields: [companyId], references: [id])
  expert    Expert?        @relation(fields: [expertId], references: [id])

  @@index([caseId])
  @@index([companyId])
  @@index([expertId])
  @@index([status])
  @@index([createdAt])
  @@index([caseId, status])
  @@index([companyId, status])
  @@index([expertId, status])
  @@index([status, createdAt])
}

model CaseStep {
  id          Int       @id @default(autoincrement())
  caseId      Int
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  tradeCase   TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, completed])
}

model CaseDocument {
  id         Int       @id @default(autoincrement())
  caseId     Int
  name       String
  storageKey String    @unique
  mimeType   String?
  fileSize   Int?
  createdAt  DateTime  @default(now())
  uploaderId Int
  tradeCase  TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploader   User      @relation(fields: [uploaderId], references: [id])

  @@index([caseId])
  @@index([uploaderId])
  @@index([createdAt])
  @@index([caseId, createdAt])
}

model CaseMessage {
  id        Int       @id @default(autoincrement())
  caseId    Int
  content   String
  createdAt DateTime  @default(now())
  senderId  Int
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id])

  @@index([caseId])
  @@index([senderId])
  @@index([createdAt])
  @@index([caseId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model Review {
  id             Int       @id @default(autoincrement())
  caseId         Int
  reviewerId     Int
  reviewedUserId Int
  rating         Int
  comment        String?
  createdAt      DateTime  @default(now())
  tradeCase      TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewedUser   User      @relation("ReviewTarget", fields: [reviewedUserId], references: [id])
  reviewer       User      @relation("ReviewAuthor", fields: [reviewerId], references: [id])

  @@unique([caseId, reviewerId, reviewedUserId])
  @@index([caseId])
  @@index([reviewerId])
  @@index([reviewedUserId])
  @@index([createdAt])
  @@index([reviewedUserId, createdAt])
  @@index([reviewerId, createdAt])
}

model Ticket {
  id        Int             @id @default(autoincrement())
  userId    Int
  subject   String
  status    String          @default("OPEN")
  category  String          @default("GENERAL")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([userId, status])
  @@index([status, createdAt])
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  senderId  Int
  message   String
  createdAt DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@index([ticketId, createdAt])
}

model CaseActivity {
  id        Int       @id @default(autoincrement())
  caseId    Int
  userId    Int?
  action    String
  details   String?
  createdAt DateTime  @default(now())
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([caseId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([caseId, createdAt])
}

model SavedCase {
  id        Int       @id @default(autoincrement())
  userId    Int
  caseId    Int
  createdAt DateTime  @default(now())
  tradeCase TradeCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
  @@index([caseId])
  @@index([createdAt])
}

model SavedCompany {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([createdAt])
}

model SavedExpert {
  id        Int      @id @default(autoincrement())
  userId    Int
  expertId  Int
  createdAt DateTime @default(now())
  expert    Expert   @relation(fields: [expertId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expertId])
  @@index([expertId])
  @@index([createdAt])
}

model ProjectConversation {
  id        Int              @id @default(autoincrement())
  projectId Int
  title     String
  createdAt DateTime         @default(now())
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ProjectMessage[]

  @@index([projectId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

model ProjectMessage {
  id             Int                 @id @default(autoincrement())
  conversationId Int
  senderId       Int
  message        String
  isRead         Boolean             @default(false)
  createdAt      DateTime            @default(now())
  conversation   ProjectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
  @@index([conversationId, createdAt])
  @@index([conversationId, isRead])
  @@index([senderId, createdAt])
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PlanType {
  FREE
  GOLD
  DIAMOND
  ENTERPRISE
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IdentityTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  EMAIL_CHANGE
}
