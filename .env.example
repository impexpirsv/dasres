# ============================================
# Dasres environment configuration
# ============================================

# Application environment:
# development | test | production
NODE_ENV=development

# Public canonical URL of the application.
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_SITE_URL=https://dasres.com

# PostgreSQL connection string.
# Never commit the real value to Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Server-only HMAC secret for password-recovery account rate-limit buckets.
# Use at least 32 random characters and keep it distinct from other secrets.
ACCOUNT_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Production VPS mode: accept a canonical client IP only when Caddy also
# supplies the matching secret. Keep this secret server-only and distinct.
TRUSTED_PROXY_MODE=local
TRUSTED_PROXY_SECRET=replace-with-a-random-proxy-secret-of-at-least-32-characters

# Server-only production SMTP connection and credentials.
SMTP_HOST=smtp.example.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password

# Deterministic sender on the verified transactional domain.
TRANSACTIONAL_EMAIL_FROM=Dasres <account@notify.example.com>

# Optional monitored reply mailbox. Leave unset if replies are not monitored.
# TRANSACTIONAL_EMAIL_REPLY_TO=support@example.com
## Future private object storage (required only when the secure workflow is activated)
OBJECT_STORAGE_ENDPOINT=https://replace-with-private-object-storage-endpoint.example
OBJECT_STORAGE_REGION=replace-with-object-storage-region
OBJECT_STORAGE_BUCKET=replace-with-private-bucket-name
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-object-storage-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-object-storage-secret-access-key

## Future private clamd service (required only when the secure workflow is activated)
MALWARE_SCANNER_HOST=replace-with-private-clamd-host
MALWARE_SCANNER_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=15000

# Absolute root containing cases/ and project-task-attachments/ legacy files.
CONFIDENTIAL_LEGACY_ROOT=/srv/dasres/legacy-private
