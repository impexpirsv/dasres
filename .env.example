# ============================================
# Dasres environment configuration
# ============================================

# Application environment:
# development | test | production
NODE_ENV=development

# Public canonical URL of the application.
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production example:
# NEXT_PUBLIC_SITE_URL=https://dasres.com

# PostgreSQL connection string.
# Never commit the real value to Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Server-only HMAC secret for password-recovery account rate-limit buckets.
# Use at least 32 random characters and keep it distinct from other secrets.
ACCOUNT_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Password-reset email is previewed in the development console only.
# Production intentionally fails closed until a TransactionalEmailProvider
# backed by the chosen delivery service is configured in server code.
