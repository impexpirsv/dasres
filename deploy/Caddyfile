www.dasres.com {
  redir https://dasres.com{uri} permanent
}

dasres.com {
  encode zstd gzip

  @privateHealth path /api/health/ready
  respond @privateHealth 404

  request_body {
    max_size 12MB
  }

  reverse_proxy 127.0.0.1:3000 {
    header_up -Forwarded
    header_up -X-Forwarded-For
    header_up -X-Real-IP
    header_up -X-Vercel-Forwarded-For
    header_up -CF-Connecting-IP
    header_up -X-Dasres-Client-IP
    header_up -X-Dasres-Proxy-Secret
    header_up X-Dasres-Client-IP {remote_host}
    header_up X-Dasres-Proxy-Secret {env.TRUSTED_PROXY_SECRET}
    transport http {
      dial_timeout 5s
      response_header_timeout 30s
    }
  }
}
