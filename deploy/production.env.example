NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
NEXT_PUBLIC_SITE_URL=https://dasres.com
ACCOUNT_RATE_LIMIT_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
TRUSTED_PROXY_MODE=local
TRUSTED_PROXY_SECRET=replace-with-an-independent-random-proxy-secret-of-at-least-32-characters
RESEND_API_KEY=replace-with-restricted-resend-key
TRANSACTIONAL_EMAIL_FROM=Dasres <account@notify.dasres.com>
# TRANSACTIONAL_EMAIL_REPLY_TO=support@dasres.com
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=replace-with-private-bucket
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-r2-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-r2-secret-key
MALWARE_SCANNER_HOST=127.0.0.1
MALWARE_SCANNER_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=15000
CONFIDENTIAL_LEGACY_ROOT=/srv/dasres/legacy-private
